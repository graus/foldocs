# Copy to .env and fill in.

# --- Required ---
# The folder's share link: Google Drive (shared with "anyone with the link") or Nextcloud.
FOLDER_URL=
# Google Drive only: a Google API key.
GOOGLE_API_KEY=
# Nextcloud only, if the link has one: its password.
FOLDER_PASSWORD=
# The site's public address.
SITE_URL=http://localhost:8000
# Your name: for the feed and the copyright line.
AUTHOR="Jan Jansen"

# --- Optional ---
# 1 keeps the site out of search engines, for a preview.
# NOINDEX=1
# Your own theme folder, starting with ./ or / (default: the bundled one).
THEME_DIR=./themes/default
# For dates (default Europe/Amsterdam).
TIMEZONE=Europe/Amsterdam
# Where the cache and the site go (default data).
DATA_DIR=data

# --- Docker ---
# A name per site: its containers, and the host name the proxy reaches it at (http://NAME:80).
COMPOSE_PROJECT_NAME=foldocs
# The Docker network of your reverse proxy.
PROXY_NETWORK=proxy
